# Test mode (NODE_ENV=test) has built-in defaults for all three; set real values elsewhere.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/alerts_test
# 32 random bytes, base64: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=
# HMAC key for phone_hash: openssl rand -base64 32
PHONE_HASH_KEY=
# Tavily API key for provider/alert verification; empty means verification fails closed (needs_review).
TAVILY_API_KEY=
# Vonage (SMS via Messages API, calls via Voice API). Read at send time; not required to boot.
VONAGE_APPLICATION_ID=
# Inline PEM or a path to the private key file
VONAGE_PRIVATE_KEY=
# Sending number, E.164
VONAGE_NUMBER=
# Max sends per second (integer, default 10)
VONAGE_RATE_PER_SECOND=
